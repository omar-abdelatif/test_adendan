parameters:
	ignoreErrors:
		-
			message: "#^PHPDoc tag @var above a method has no effect\\.$#"
			count: 1
			path: app/Console/Commands/CheckSubscriptionExpiry.php

		-
			message: "#^PHPDoc tag @var does not specify variable name\\.$#"
			count: 1
			path: app/Console/Commands/CheckSubscriptionExpiry.php

		-
			message: "#^Variable \\$subscribers in empty\\(\\) always exists and is not falsy\\.$#"
			count: 1
			path: app/Console/Commands/NotifyUpcomingExpiry.php

		-
			message: "#^Access to an undefined property App\\\\Models\\\\Subscribers\\|App\\\\Models\\\\User\\:\\:\\$job_title\\.$#"
			count: 1
			path: app/Http/Controllers/Api/UserController.php

		-
			message: "#^Call to an undefined method Illuminate\\\\Http\\\\Request\\:\\:validated\\(\\)\\.$#"
			count: 1
			path: app/Http/Controllers/AssociationCommittesController.php

		-
			message: "#^Method App\\\\Http\\\\Controllers\\\\Auth\\\\LoginController\\:\\:authenticated\\(\\) invoked with 2 parameters, 1 required\\.$#"
			count: 1
			path: app/Http/Controllers/Auth/LoginController.php

		-
			message: "#^Variable \\$imagename might not be defined\\.$#"
			count: 1
			path: app/Http/Controllers/BoardMembersController.php

		-
			message: "#^Access to an undefined property App\\\\Models\\\\Donators\\:\\:\\$outerdonations\\.$#"
			count: 1
			path: app/Http/Controllers/DonatorsController.php

		-
			message: "#^Access to an undefined property App\\\\Models\\\\News\\:\\:\\$is_landscape\\.$#"
			count: 2
			path: app/Http/Controllers/Frontend/News/NewsController.php

		-
			message: "#^Access to an undefined property App\\\\Models\\\\News\\:\\:\\$is_portrait\\.$#"
			count: 1
			path: app/Http/Controllers/Frontend/News/NewsController.php

		-
			message: "#^Access to an undefined property App\\\\Models\\\\News\\:\\:\\$is_square\\.$#"
			count: 1
			path: app/Http/Controllers/Frontend/News/NewsController.php

		-
			message: "#^Access to an undefined property App\\\\Models\\\\News\\|Illuminate\\\\Database\\\\Eloquent\\\\Collection\\<int, App\\\\Models\\\\News\\>\\:\\:\\$thumbnails\\.$#"
			count: 1
			path: app/Http/Controllers/NewsController.php

		-
			message: "#^Access to an undefined property App\\\\Models\\\\News\\|Illuminate\\\\Database\\\\Eloquent\\\\Collection\\<int, App\\\\Models\\\\News\\>\\:\\:\\$videos\\.$#"
			count: 1
			path: app/Http/Controllers/NewsController.php

		-
			message: "#^Cannot access property \\$id on null\\.$#"
			count: 1
			path: app/Http/Controllers/NewsController.php

		-
			message: "#^Variable \\$news might not be defined\\.$#"
			count: 2
			path: app/Http/Controllers/NewsController.php

		-
			message: "#^Variable \\$store might not be defined\\.$#"
			count: 1
			path: app/Http/Controllers/NewsController.php

		-
			message: "#^Class App\\\\Imports\\\\importSmsSubscribers referenced with incorrect case\\: App\\\\Imports\\\\ImportSmsSubscribers\\.$#"
			count: 2
			path: app/Http/Controllers/SMSController.php

		-
			message: "#^Call to an undefined method Illuminate\\\\Http\\\\Request\\:\\:validated\\(\\)\\.$#"
			count: 1
			path: app/Http/Controllers/WorkerController.php

		-
			message: "#^Array has 2 duplicate keys with value 'role' \\('role', 'role'\\)\\.$#"
			count: 1
			path: app/Http/Kernel.php

		-
			message: "#^Access to undefined constant App\\\\Providers\\\\RouteServiceProvider\\:\\:MEDIA\\.$#"
			count: 1
			path: app/Http/Middleware/Role.php

		-
			message: "#^Access to undefined constant App\\\\Providers\\\\RouteServiceProvider\\:\\:SUBSCRIPTIONS\\.$#"
			count: 1
			path: app/Http/Middleware/Role.php

		-
			message: "#^Access to an undefined property App\\\\Models\\\\Donations\\:\\:\\$payment_type\\.$#"
			count: 1
			path: app/Models/Donations.php

		-
			message: "#^Call to an undefined method App\\\\Models\\\\SMSSubscribers\\:\\:belongTo\\(\\)\\.$#"
			count: 1
			path: app/Models/SMSSubscribers.php

		-
			message: "#^Access to an undefined property Illuminate\\\\Database\\\\Eloquent\\\\Model\\:\\:\\$name\\.$#"
			count: 1
			path: app/Models/SpatieActivityLog.php

		-
			message: "#^Method App\\\\Services\\\\EgyptLinxSmsService\\:\\:calculateSmsCount\\(\\) should return int but returns float\\.$#"
			count: 1
			path: app/Services/EgyptLinxSmsService.php
