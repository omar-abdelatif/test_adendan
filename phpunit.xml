<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="BCRYPT_ROUNDS" value="4"/>
    <env name="CACHE_DRIVER" value="array"/>
    <!-- Tests run on their own MySQL database (the schema uses MySQL-only features). -->
    <env name="DB_CONNECTION" value="mysql"/>
    <env name="DB_DATABASE" value="adendan_test"/>
    <env name="PAYMOB_HMAC_SECRET" value="test-hmac-secret"/>
    <env name="OCR_API_KEY" value="test-ocr-key"/>
    <env name="EGYPTLINX_SMS_PROVIDER" value="test"/>
    <env name="EGYPTLINX_SMS_PASSWORD" value="test"/>
    <env name="EGYPTLINX_SMS_SENDER" value="test"/>
    <env name="MAIL_MAILER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="TELESCOPE_ENABLED" value="false"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
